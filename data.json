      "theory_id": 13,
      "sub_theory_id": 1,
      "source_id": 3,
      "title": "Unseen Elder Ouroboros",
      "description": "This symbol is visible above an arch when leaving the cave with the inverted gravity inside of the Unseen Elder's cave. This is the pure vampiric ouroboros with its base colors, and without any text.",
      "thumbnail_url": "Images/Thumbnail/01c5de84-e822-4d3e-a8ef-044d5ccd47e9.jpg",
      "image_url": "Images/Full/01c5de84-e822-4d3e-a8ef-044d5ccd47e9.jpg"
